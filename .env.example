# Copy to .env.local. Values here are for local development.

# Where the Spring Boot API (backend/) is reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# The OAuth2 client this workspace signs in as. Must match weadk.oauth2.client.id on
# the API, and that client's registered redirect URI must be this app's
# /auth/callback. A mismatch is the most common reason an OAuth2 flow fails.
NEXT_PUBLIC_OAUTH_CLIENT_ID=we-adk-workspace

# --- The API (backend/), read by docker-compose.yml ---
# Ports. 5433 keeps Postgres out of the way of anything already on 5432.
DB_PORT=5433
API_PORT=8080

# `open` leaves /api/** unauthenticated, for local work. `jwt` requires a bearer token,
# and then WEADK_JWT_SECRET must be set to at least 32 bytes.
SECURITY_MODE=open
WEADK_JWT_SECRET=
# The first account, created once on an empty user table.
WEADK_SEED_EMAIL=
WEADK_SEED_PASSWORD=

# The AI endpoints. Unset, they report themselves unavailable rather than failing.
ANTHROPIC_API_KEY=

# Where the Next.js server reaches the API. Differs from NEXT_PUBLIC_API_BASE_URL when the
# API answers on a container network name the browser cannot resolve.
# API_INTERNAL_URL=http://localhost:8080
