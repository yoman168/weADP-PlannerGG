# The prod stack.
#
# Copy to `deploy/prod.env` and fill in. That file is git-ignored, because unlike the dev
# one every credential here is real.
#
# Ports are offset from the dev stack so both can run on one host at the same time.

STACK_NAME=weadk-prod

WEB_PORT=3100
API_PORT=8180
DB_PORT=5434
ADMINER_PORT=8190

# The URLs a browser will actually use. Behind a reverse proxy or a real domain these are
# the public ones, not localhost — they become the OAuth2 issuer, the registered redirect
# URI and the CORS origin, and a browser rejects a mismatch.
#
# One consequence worth knowing: the web image inlines PUBLIC_API_URL at build time, so
# changing it needs `--build`, not just a restart. And the redirect URI is seeded into
# `oauth2_registered_client` on first boot, so changing it later means updating that row.
PUBLIC_WEB_URL=https://weadk.example.com
PUBLIC_API_URL=https://api.weadk.example.com

DB_NAME=weadk
DB_USER=weadk
DB_PASSWORD=CHANGE-ME

SECURITY_MODE=oauth2
OAUTH_CLIENT_ID=we-adk-workspace

# The first account. Delete these two lines after the first boot: they are only read when
# the user table is empty, so leaving them in is a password sitting in a file for no reason.
SEED_EMAIL=admin@example.com
SEED_PASSWORD=CHANGE-ME
SEED_NAME=Administrator

# Unused by `oauth2`. Leave empty unless you switch to `jwt`.
#
# If you do switch: generate a fresh one, at least 32 bytes —
#
#   openssl rand -base64 48
#
# and do NOT copy the value out of deploy/dev.env. That file is committed, so its secret is
# public, and a token signed with a public key is a token anyone can mint. The service
# refuses to start on a secret shorter than 32 bytes but cannot tell a leaked one from a
# good one.
JWT_SECRET=

# The organisation's key. Without it the AI endpoints answer 503 with an explanation.
ANTHROPIC_API_KEY=

# A public deployment has little reason to publish its own API surface.
SPRINGDOC_ENABLED=false
