# The dev stack.
#
# Committed on purpose. Every value here is either a port or a throwaway credential for a
# database that lives in a local volume, so there is nothing to protect and having it in the
# repository means `pnpm stack:dev` works on a fresh clone with nothing to fill in first.
#
# The ports are the ones this project has always used, so existing bookmarks keep working.

STACK_NAME=weadk-dev

WEB_PORT=3000
API_PORT=8080
DB_PORT=5433
ADMINER_PORT=8090

# What the browser is told. Must match the published ports above, because these become the
# OAuth2 issuer, the redirect URI and the CORS origin — all of which the browser checks.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

DB_NAME=weadk
DB_USER=weadk
DB_PASSWORD=weadk

# `oauth2` gives the sign-in screen. Set `open` to work without signing in at all.
SECURITY_MODE=oauth2
OAUTH_CLIENT_ID=we-adk-workspace

# The first account, created once when the user table is empty. Change these and clear
# `app_user` to change who can sign in.
SEED_EMAIL=you@example.com
SEED_PASSWORD=workspace-dev-password
SEED_NAME=WE-ADK developer

# Only used by `SECURITY_MODE=jwt`. At least 32 bytes.
#
# Committed, therefore public, therefore development-only — the name says so because a
# value like this reaching production would let anyone mint a valid token. See the note in
# deploy/prod.env.example before setting one there.
JWT_SECRET=development-only-secret-that-is-long-enough

# Left empty: the AI endpoints then report themselves unavailable rather than failing.
ANTHROPIC_API_KEY=

SPRINGDOC_ENABLED=true
